{
  "name": "@coaching-life/backend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:init": "tsx src/db/migrate.ts && tsx src/db/seed.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:db:up": "docker run --rm -d --name coaching-life-test-db -e POSTGRES_PASSWORD=test -p 54329:5432 postgres:18",
    "test:db:down": "docker rm -f coaching-life-test-db",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@vercel/functions": "^3.11.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
