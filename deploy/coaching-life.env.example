# Variables de production de la pile `deploy/compose.yaml`. Modèle sans secret : coller le contenu
# rempli dans l'onglet Environment du service Compose de Dokploy, qui l'écrit dans le `.env` voisin
# du compose. Le fichier rempli ne se versionne jamais et ne se colle ni dans une issue ni dans un
# journal de CI. Une variable facultative se laisse commentée.

# --- Postgres (service de base de données de Dokploy, hors de la pile) ------------------------------
# À recopier depuis la fiche du service dans Dokploy (Internal Credentials). Le mot de passe entre
# tel quel dans l'URL de connexion : le choisir en hexadécimal (openssl rand -hex 32).
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=

# --- Application ------------------------------------------------------------------------------------
# À reprendre à l'identique de Vercel : le changer déconnecte toutes les sessions.
SESSION_SECRET=
CORS_ORIGIN=https://coaching-life.nedellec-julien.fr
# En-tête qui porte l'adresse du visiteur. Par défaut cf-connecting-ip (tunnel Cloudflare).
# CLIENT_IP_HEADER=
# Seed lancé à chaque démarrage : crée ce compte s'il n'existe pas, ne modifie jamais un compte existant.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stockage des fichiers (Cloudflare R2) : mêmes valeurs que sur Vercel
S3_ENDPOINT=
# S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Mail (SMTP) : mêmes valeurs que sur Vercel
SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_FROM="Coaching Life <noreply@coaching-life.nedellec-julien.fr>"

# --- Sauvegardes de la base -------------------------------------------------------------------------
# Bucket R2 privé, distinct de celui des fichiers, avec un jeton d'API limité à ce bucket.
# https://<identifiant de compte>.r2.cloudflarestorage.com, sans `/` final
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# openssl rand -base64 48 ; à conserver aussi hors du serveur (gestionnaire de mots de passe) :
# sans elle, aucune sauvegarde ne se déchiffre.
BACKUP_PASSPHRASE=

# --- Retour à une version (facultatif) --------------------------------------------------------------
# APP_IMAGE=ghcr.io/j-ned/coaching-life-app:sha-<commit>
