# Backend
DATABASE_URL=postgresql://user:password@localhost:5432/coaching_life
SESSION_SECRET=change_me_to_a_random_32_chars_string
PORT=3000
# Dev : http://localhost:4200 — Prod : https://coaching-life.nedellec-julien.fr
CORS_ORIGIN=http://localhost:4200

# Cloudflare R2 (compatible S3)
# Endpoint : https://<ACCOUNT_ID>.r2.cloudflarestorage.com (Cloudflare → R2 → Settings)
S3_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=your_r2_access_key_id
S3_SECRET_KEY=your_r2_secret_access_key
S3_BUCKET=coaching-img

# Mail (SMTP)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Coaching Life <noreply@coaching-life.nedellec-julien.fr>"

# Seed
ADMIN_EMAIL=admin@coaching-life.nedellec-julien.fr
ADMIN_PASSWORD=changeme

# Frontend (injecté au build CI)
API_URL=http://localhost:3000
